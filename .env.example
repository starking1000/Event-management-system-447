# Event Management System Environment Configuration
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=eventmanagement

# Application Configuration
APP_NAME="Event Management System"
APP_URL=http://localhost:8000
APP_DEBUG=true

# Email Configuration (for future notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@eventmanagement.local
MAIL_FROM_NAME="Event Management System"

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=false

# Admin Configuration
ADMIN_EMAIL=admin@eventmanagement.local
DEFAULT_TIMEZONE=America/New_York